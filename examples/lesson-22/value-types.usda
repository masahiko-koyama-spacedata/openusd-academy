#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Sphere "Ball"
    {
        double radius = 0.6
        color3f[] primvars:displayColor = [(0.85, 0.2, 0.2)] (
            interpolation = "constant"
        )
        double3 xformOp:translate = (-0.9, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Box"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.15, 0.35, 0.85)] (
            interpolation = "constant"
        )
        double3 xformOp:translate = (0.9, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Camera "ShotCam"
    {
        float focalLength = 50
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 9.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
