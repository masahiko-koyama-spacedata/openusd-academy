#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "Widget" (
        prepend variantSets = "look"
        variants = {
            string look = "plain"
        }
    )
    {
        variantSet "look" = {
            "plain" {
                def Cube "Body"
                {
                    double size = 1
                    color3f[] primvars:displayColor = [(0.62, 0.62, 0.64)]
                }
            }
            "warm" {
                def Cube "Body"
                {
                    double size = 1
                    color3f[] primvars:displayColor = [(0.85, 0.2, 0.2)]
                }
                def Sphere "Badge"
                {
                    double radius = 0.3
                    color3f[] primvars:displayColor = [(0.2, 0.7, 0.3)]
                    double3 xformOp:translate = (0, 0.9, 0)
                    uniform token[] xformOpOrder = ["xformOp:translate"]
                }
            }
            "cool" {
                def Cube "Body"
                {
                    double size = 1
                    color3f[] primvars:displayColor = [(0.15, 0.35, 0.85)]
                }
            }
        }
    }

    def Camera "ShotCam"
    {
        float focalLength = 50
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 8)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
