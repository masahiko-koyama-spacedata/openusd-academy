#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Always"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.85, 0.2, 0.2)]
        double3 xformOp:translate = (-2.4, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def "Heavy" (
        payload = @payload-detail.usda@
    )
    {
        double3 xformOp:translate = (1.2, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "ShotCam"
    {
        float focalLength = 50
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (-0.3, 0, 14)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
