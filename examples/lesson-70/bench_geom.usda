#usda 1.0
(
    defaultPrim = "Bench"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Bench"
{
    def Cube "Seat"
    {
        double size = 1
        float3 xformOp:scale = (1.8, 0.12, 0.5)
        double3 xformOp:translate = (0, 0.45, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Leg_1"
    {
        double size = 1
        float3 xformOp:scale = (0.12, 0.4, 0.4)
        double3 xformOp:translate = (-0.7, 0.2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Leg_2"
    {
        double size = 1
        float3 xformOp:scale = (0.12, 0.4, 0.4)
        double3 xformOp:translate = (0.7, 0.2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Camera "AssetCam"
    {
        float2 clippingRange = (0.1, 100)
        float focalLength = 50
        double3 xformOp:translate = (0, 0.35, 5.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

