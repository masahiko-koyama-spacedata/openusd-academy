#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def "Lamp_A" (
        references = @lamp.usda@
        variants = {
            string shade = "warm"
        }
    )
    {
        double3 xformOp:translate = (-2.2, -1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def "Lamp_B" (
        references = @lamp.usda@
        variants = {
            string shade = "cool"
        }
    )
    {
        double3 xformOp:translate = (0, -1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def "Lamp_C" (
        references = @lamp.usda@
        variants = {
            string shade = "dark"
        }
    )
    {
        double3 xformOp:translate = (2.2, -1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "ShotCam"
    {
        float focalLength = 50
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0.2, 16)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
