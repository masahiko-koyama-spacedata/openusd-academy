#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

over "World"
{
    def Xform "Set"
    {
        def Cube "Floor"
        {
            double size = 6
            float3 xformOp:scale = (1, 0.05, 1)
            uniform token[] xformOpOrder = ["xformOp:scale"]
        }
    }
}
