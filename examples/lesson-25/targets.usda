#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Sphere "Ball"
    {
        double radius = 2
    }

    def Cube "Box"
    {
        double size = 2
    }

    def Scope "Selection"
    {
        custom rel primary = </World/Ball>

        custom rel members = [
            </World/Ball>,
            </World/Box>,
        ]

        custom rel driver = </World/Ball.radius>
    }
}
