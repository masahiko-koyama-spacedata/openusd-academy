#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

class Xform "_Style"
{
    color3f[] primvars:displayColor = [(0.2, 0.6, 0.3)] (
        interpolation = "constant"
    )
}

def Xform "World"
{
    def Xform "Chair" (
        inherits = </_Style>
        prepend references = @./base.usda@
    )
    {
    }
}
