#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    subLayers = [
        @specifier-base.usda@
    ]
    upAxis = "Y"
)

over "World"
{
    over "Retouched"
    {
        color3f[] primvars:displayColor = [(0.15, 0.35, 0.85)]
    }

    over "NotThere"
    {
        color3f[] primvars:displayColor = [(0.2, 0.7, 0.3)]
    }
}
