#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "A" (
        instanceable = true
        prepend references = @./chair.usda@
    )
    {
        double3 xformOp:translate = (-1.6, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "B" (
        instanceable = true
        prepend references = @./chair.usda@
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "C" (
        instanceable = true
        prepend references = @./chair.usda@
    )
    {
        double3 xformOp:translate = (1.6, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
