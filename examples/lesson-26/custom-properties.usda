#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Sphere "Ball"
    {
        double radius = 2

        custom string academy:owner = "lighting"
        custom float academy:score = 12.5
        custom rel academy:relatedTo = </World/Box>
    }

    def Cube "Box"
    {
        double size = 1
    }
}
