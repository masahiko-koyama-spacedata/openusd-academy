#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    # 左: subdivisionScheme = "none" — 書いた8点・6面のまま
    def Mesh "AsWritten"
    {
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [
            0, 1, 3, 2,
            4, 6, 7, 5,
            0, 4, 5, 1,
            2, 3, 7, 6,
            0, 2, 6, 4,
            1, 5, 7, 3,
        ]
        point3f[] points = [
            (-0.5, -0.5, 0.5), (0.5, -0.5, 0.5), (-0.5, 0.5, 0.5), (0.5, 0.5, 0.5),
            (-0.5, -0.5, -0.5), (0.5, -0.5, -0.5), (-0.5, 0.5, -0.5), (0.5, 0.5, -0.5),
        ]
        color3f[] primvars:displayColor = [(0.85, 0.2, 0.2)] (
            interpolation = "constant"
        )
        double3 xformOp:translate = (-0.9, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # 右: subdivisionScheme = "catmullClark" — 同じ8点・6面が丸められる
    def Mesh "Subdivided"
    {
        uniform token subdivisionScheme = "catmullClark"
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [
            0, 1, 3, 2,
            4, 6, 7, 5,
            0, 4, 5, 1,
            2, 3, 7, 6,
            0, 2, 6, 4,
            1, 5, 7, 3,
        ]
        point3f[] points = [
            (-0.5, -0.5, 0.5), (0.5, -0.5, 0.5), (-0.5, 0.5, 0.5), (0.5, 0.5, 0.5),
            (-0.5, -0.5, -0.5), (0.5, -0.5, -0.5), (-0.5, 0.5, -0.5), (0.5, 0.5, -0.5),
        ]
        color3f[] primvars:displayColor = [(0.15, 0.35, 0.85)] (
            interpolation = "constant"
        )
        double3 xformOp:translate = (0.9, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "ShotCam"
    {
        float focalLength = 50
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 2.6, 8.5)
        float3 xformOp:rotateXYZ = (-17, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
