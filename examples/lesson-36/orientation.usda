#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    # 左: 既定の rightHanded。カメラ側から見て反時計回りに並んでいる
    def Mesh "RightHanded"
    {
        uniform token subdivisionScheme = "none"
        uniform token orientation = "rightHanded"
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.5, -0.5, 0), (0.5, -0.5, 0), (0.5, 0.5, 0), (-0.5, 0.5, 0)]
        color3f[] primvars:displayColor = [(0.85, 0.2, 0.2)] (
            interpolation = "constant"
        )
        double3 xformOp:translate = (-0.8, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # 右: 点も index も同じで、orientation だけ leftHanded にする
    def Mesh "LeftHanded"
    {
        uniform token subdivisionScheme = "none"
        uniform token orientation = "leftHanded"
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.5, -0.5, 0), (0.5, -0.5, 0), (0.5, 0.5, 0), (-0.5, 0.5, 0)]
        color3f[] primvars:displayColor = [(0.15, 0.35, 0.85)] (
            interpolation = "constant"
        )
        double3 xformOp:translate = (0.8, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "ShotCam"
    {
        float focalLength = 50
        float2 clippingRange = (0.1, 100)
        double3 xformOp:translate = (0, 0, 8)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
