#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 24
    timeCodesPerSecond = 24
    framesPerSecond = 24
)

def Xform "World"
{
    # velocities 無し。Time Sample どうしを線形に補間する
    def Points "NoVel"
    {
        point3f[] points.timeSamples = {
            0: [(0, 0, 0)],
            24: [(10, 0, 0)],
        }
        float[] widths = [0.2]
    }

    # velocities 有り。位置は「速度 × 経過秒」で決まる
    def Points "WithVel"
    {
        point3f[] points.timeSamples = {
            0: [(0, 1, 0)],
            24: [(10, 1, 0)],
        }
        vector3f[] velocities.timeSamples = {
            0: [(24, 0, 0)],
            24: [(24, 0, 0)],
        }
        float[] widths = [0.2]
    }
}
