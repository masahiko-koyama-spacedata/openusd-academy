#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    # 左: 何も指定しない catmullClark。全体が丸くなる
    def Mesh "Plain"
    {
        uniform token subdivisionScheme = "catmullClark"
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [
            0, 1, 3, 2,
            4, 6, 7, 5,
            0, 4, 5, 1,
            2, 3, 7, 6,
            0, 2, 6, 4,
            1, 5, 7, 3,
        ]
        point3f[] points = [
            (-0.5, -0.5, 0.5), (0.5, -0.5, 0.5), (-0.5, 0.5, 0.5), (0.5, 0.5, 0.5),
            (-0.5, -0.5, -0.5), (0.5, -0.5, -0.5), (-0.5, 0.5, -0.5), (0.5, 0.5, -0.5),
        ]
        color3f[] primvars:displayColor = [(0.85, 0.3, 0.25)] (interpolation = "constant")
        double3 xformOp:translate = (-1.4, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # 右: 上面の4辺を crease で立て、角を corner で尖らせる
    def Mesh "Creased"
    {
        uniform token subdivisionScheme = "catmullClark"
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [
            0, 1, 3, 2,
            4, 6, 7, 5,
            0, 4, 5, 1,
            2, 3, 7, 6,
            0, 2, 6, 4,
            1, 5, 7, 3,
        ]
        point3f[] points = [
            (-0.5, -0.5, 0.5), (0.5, -0.5, 0.5), (-0.5, 0.5, 0.5), (0.5, 0.5, 0.5),
            (-0.5, -0.5, -0.5), (0.5, -0.5, -0.5), (-0.5, 0.5, -0.5), (0.5, 0.5, -0.5),
        ]

        # 上面の輪郭になる4辺を、1本の閉じた折れ線として指定する
        int[] creaseIndices = [2, 3, 7, 6, 2]
        int[] creaseLengths = [5]
        float[] creaseSharpnesses = [10]

        color3f[] primvars:displayColor = [(0.25, 0.45, 0.85)] (interpolation = "constant")
        double3 xformOp:translate = (1.4, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DistantLight "Key"
    {
        float inputs:intensity = 18000
        float3 xformOp:rotateXYZ = (-35, 25, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Camera "ShotCam"
    {
        float focalLength = 35
        float2 clippingRange = (0.1, 200)
        double3 xformOp:translate = (0, 1.2, 7)
        float3 xformOp:rotateXYZ = (-10, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
