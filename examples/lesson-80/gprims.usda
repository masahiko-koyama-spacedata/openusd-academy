#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Box"
    {
        double size = 1
        color3f[] primvars:displayColor = [(0.85, 0.25, 0.2)] (interpolation = "constant")
        double3 xformOp:translate = (-3.2, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Ball"
    {
        double radius = 0.6
        color3f[] primvars:displayColor = [(0.8, 0.5, 0.15)] (interpolation = "constant")
        double3 xformOp:translate = (-1.6, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Pipe"
    {
        uniform token axis = "Y"
        double height = 1.2
        double radius = 0.45
        color3f[] primvars:displayColor = [(0.55, 0.65, 0.2)] (interpolation = "constant")
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cone "Tip"
    {
        uniform token axis = "Y"
        double height = 1.2
        double radius = 0.55
        color3f[] primvars:displayColor = [(0.2, 0.6, 0.45)] (interpolation = "constant")
        double3 xformOp:translate = (1.6, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Capsule "Pill"
    {
        uniform token axis = "Y"
        double height = 0.8
        double radius = 0.35
        color3f[] primvars:displayColor = [(0.25, 0.45, 0.85)] (interpolation = "constant")
        double3 xformOp:translate = (3.2, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def DistantLight "Key"
    {
        float inputs:intensity = 18000
        float3 xformOp:rotateXYZ = (-35, 25, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Camera "ShotCam"
    {
        float focalLength = 35
        float2 clippingRange = (0.1, 200)
        double3 xformOp:translate = (0, 0.1, 15)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
