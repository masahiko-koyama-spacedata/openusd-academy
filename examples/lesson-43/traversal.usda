#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

class Xform "_Style"
{
    float3 xformOp:scale = (2, 2, 2)
    uniform token[] xformOpOrder = ["xformOp:scale"]
}

def Xform "World" (
    kind = "group"
)
{
    def Xform "Robot" (
        kind = "component"
    )
    {
        def Cube "Body"
        {
            double size = 1
        }

        def Cube "Spare" (
            active = false
        )
        {
            double size = 1
        }
    }

    over "Placeholder"
    {
        double size = 1
    }

    def Xform "Styled" (
        inherits = </_Style>
    )
    {
    }
}
