{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Academy: Check Site",
      "detail": "全ページのリンク・タグ・レッスン必須要素を検査する",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/check_site.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Academy: Rebuild Curriculum",
      "detail": "学習順序・章ページ・前後ナビ・STEP番号を tools/reorder.py から再生成する",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/reorder.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
